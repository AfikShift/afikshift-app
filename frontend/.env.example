# Copy to frontend/.env and fill in. Never commit the real file.
# Public URL of the FastAPI backend (no trailing slash, no /api suffix)
EXPO_PUBLIC_BACKEND_URL=https://REPLACE_WITH_YOUR_API_DOMAIN
# Ed25519 PUBLIC key (hex) matching the backend's entitlement signing key (public value, safe to ship in the app)
EXPO_PUBLIC_ENTITLEMENT_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY_HEX
# Billing store for this build: aptoide | play (default play)
EXPO_PUBLIC_STORE=aptoide
