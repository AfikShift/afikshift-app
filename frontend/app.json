{
  "expo": {
    "name": "DutyConnect",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.dutyconnectbeta.qws5xm",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock DutyConnect securely with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.dutyconnectbeta.qws5xm",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock DutyConnect securely with Face ID"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
