# Copy to backend/.env and replace every REPLACE value. Never commit the real file.
ENVIRONMENT=production
MONGO_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/?retryWrites=true&w=majority
DB_NAME=dutyconnect
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
CORS_ORIGINS=https://YOUR-DOMAIN.example
DEV_LOG_CODES=false

# Email (see docs/HOSTING.md section 2)
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE
EMAIL_FROM_ADDRESS=no-reply@YOUR-DOMAIN.example
EMAIL_FROM_NAME=DutyConnect
EMAIL_REPLY_TO=support@YOUR-DOMAIN.example

# Public pages / policy
DATA_CONTROLLER_NAME="[YOUR ORGANISATION NAME]"
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example
SUPPORT_EMAIL=support@YOUR-DOMAIN.example
POLICY_LAST_UPDATED="[DATE]"

# Protection
RATE_LIMIT_PER_MIN=600
PUBLIC_RATE_LIMIT_PER_MIN=10
TRUSTED_PROXY_HOPS=1

# Backups (docs/BACKUPS.md)
BACKUP_KEY_FILE=/etc/dutyconnect/backup.key
BACKUP_DIR=/var/backups/dutyconnect
BACKUP_RETENTION_DAYS=35

# Phase C referrals
ADMIN_EMAILS=admin@YOUR-DOMAIN
REFERRAL_MONTHLY_CAP=3
AMBASSADOR_MONTHLY_CAP=10
REFERRAL_APPLY_WINDOW_DAYS=14
# Aptoide store page (placeholder until live)
APTOIDE_URL=https://dutyconnect.en.aptoide.com
# Direct APK distribution (stable link /api/public/download/android redirects to APK_URL)
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APK_URL=

# Test-only: password of the pre-verified pytest user (preview/staging only)
TEST_MAIN_PASSWORD=REPLACE_WITH_TEST_PASSWORD

# Billing & entitlements (docs/BILLING.md). Generate fresh keys - never reuse preview keys.
# BILLING_MODE: mock (test double) | google (real Play Developer API)
BILLING_MODE=mock
ANDROID_PACKAGE=uk.afikshift.app
# 32 random bytes, hex:  python -c "import secrets;print(secrets.token_hex(32))"
BILLING_TOKEN_KEY=REPLACE_WITH_64_HEX_CHARS
# Ed25519 private key (32 bytes hex). Put the matching PUBLIC key in frontend EXPO_PUBLIC_ENTITLEMENT_PUBLIC_KEY.
ENTITLEMENT_SIGNING_KEY=REPLACE_WITH_64_HEX_CHARS
RTDN_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
# Path to Google Play service-account JSON (only when BILLING_MODE=google; keep file out of git)
GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/play-service-account.json
# Only needed when EMAIL_PROVIDER uses the Emergent email proxy
EMERGENT_EMAIL_KEY=REPLACE_IF_USED
MAX_BODY_BYTES=2097152
